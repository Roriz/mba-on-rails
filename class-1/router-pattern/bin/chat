#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/environment'
require 'colorize'

# Ensure API key is set
if ENV['GEMINI_API_KEY'].nil? || ENV['GEMINI_API_KEY'].empty?
  puts "\n[!] ERROR: GEMINI_API_KEY is not set.".colorize(:red)
  puts "Please create a ".colorize(:yellow) + ".env".colorize(:light_blue) + " file in the root of the project with:".colorize(:yellow)
  puts "GEMINI_API_KEY=your_api_key_here\n\n".colorize(:light_cyan)
  exit 1
end

puts "\n" + "=" * 60
puts " 🛡️  WATSONVILLE CHEVROLET INVENTORY ASSISTANT (SECURE ROUTER)  🛡️ ".center(60).colorize(:light_green).swap
puts "=" * 60
puts "Type ".colorize(:light_black) + "/reset".colorize(:cyan) + " to clear chat history.".colorize(:light_black)
puts "Type ".colorize(:light_black) + "/history".colorize(:magenta) + " to see the full raw prompt payload.".colorize(:light_black)
puts "Type ".colorize(:light_black) + "/exit".colorize(:red) + " to quit the chat.".colorize(:light_black)
puts "=" * 60 + "\n"

begin
  assistant = Chatbots::RouterCarAssistant.new
  puts "Bot: ".colorize(:green) + "Hello! I am Watsonville Chevrolet's secure inventory assistant. How can I help you today?"
  
  loop do
    print "\nYou: ".colorize(:blue)
    input = gets
    break if input.nil? # Handle Ctrl+D
    
    input = input.strip
    next if input.empty?
    
    case input.downcase
    when '/exit'
      puts "\nGoodbye!".colorize(:yellow)
      break
    when '/reset'
      assistant.reset_chat!
      puts "\n[System] Chat history reset.".colorize(:cyan)
      puts "Bot: ".colorize(:green) + "Hello! I am Watsonville Chevrolet's inventory assistant. How can I help you today?"
    when '/history'
      puts "\n" + "-" * 60
      puts " RAW CHAT HISTORY (PAYLOAD SENT TO GEMINI) ".center(60).colorize(:magenta).swap
      puts "-" * 60
      assistant.history.each_with_index do |turn, idx|
        role_color = turn[:role] == 'user' ? :blue : :green
        puts "\n[Turn #{idx + 1}] Role: #{turn[:role].upcase}".colorize(role_color).bold
        puts turn[:parts].map { |p| p[:text] }.join("\n")
      end
      puts "-" * 60 + "\n"
    else
      print "Bot is thinking...".colorize(:light_black)
      response = assistant.chat(input)
      # Clear the "thinking" message
      print "\r" + " " * 30 + "\r"
      
      # Print the secure router pipeline trace
      trace = assistant.last_trace
      if trace
        puts "\n" + "·" * 60
        puts " 🛡️  SECURE ROUTER PIPELINE TRACE ".center(60).colorize(:light_cyan).bold.swap
        puts "·" * 60
        puts "1. INTENT CLASSIFICATION (LLM Routing)".colorize(:cyan).bold
        puts "   - Raw Classification: ".colorize(:light_black) + trace[:intent_raw_response].to_s.strip.colorize(:yellow)
        puts "   - Parsed Action:      ".colorize(:light_black) + trace[:routing_decision].to_s.inspect.colorize(:green)
        
        puts "\n2. DETERMINISTIC APPLICATION LOGIC".colorize(:cyan).bold
        puts "   - Execution:          ".colorize(:light_black) + trace[:db_query].to_s.colorize(:magenta)
        puts "   - Database Returned:  ".colorize(:light_black) + trace[:db_result].inspect.colorize(:green)
        
        puts "\n3. CONTROLLED FORMATTED GENERATION".colorize(:cyan).bold
        puts "   - Output formatted with strict, read-only database facts."
        puts "·" * 60 + "\n"
      end

      puts "Bot: ".colorize(:green) + response
    end
  end
rescue Interrupt
  puts "\nGoodbye!".colorize(:yellow)
rescue => e
  puts "\n[!] Fatal Error: #{e.message}".colorize(:red)
  puts e.backtrace.first(5).join("\n").colorize(:light_black)
end
