  puts "═" * 75
  puts "  Rank | Candidate           | Naive Score | Jury Score"
  puts "  " + "─" * 71

  # Sort leaderboard by Jury Score descending
  sorted_leaderboard = leaderboard.sort_by { |item| -item[:jury] }

  sorted_leaderboard.each_with_index do |item, idx|
    rank = idx + 1
    fit_color = if item[:jury] >= 90
                  :light_green
                elsif item[:jury] >= 60
                  :yellow
                else
                  :light_red
                end

    puts "  #{rank.to_s.rjust(4)} | " +
         "#{item[:name].ljust(19)}".colorize(fit_color).bold + " | " +
         "#{item[:naive].to_s.rjust(3)} / 100".colorize(:light_red) + "   | " +
         "#{item[:jury].to_s.rjust(3)} / 100".colorize(fit_color).bold
  end
  puts "  " + "─" * 71
  puts "[Conclusion] By using ActiveGenie Multi-Persona Scoring, recruitment mitigates proxy biases"
  puts " and aligns candidates objectively based purely on technical skill, experience, and role fit.".colorize(:light_green)
  puts "═" * 75 + "\n\n"
end

# Consistency test: run all candidates 3 times each in random order and compare scores.
# This proves (or disproves) that the jury approach produces stable, repeatable scores.
#
# @param key [Symbol] Key of the example in EXAMPLES hash.
# @param runs [Integer] Number of evaluation rounds.
def run_consistency_test(key, runs: 3)
  ex = EXAMPLES[key]
  unless ex
    puts "Error: Example '#{key}' not found.".colorize(:red)
    return
  end

  puts "\n" + "═" * 70
  puts " 🔬  CONSISTENCY TEST: #{ex[:name].upcase}  🔬 ".colorize(:magenta).swap
  puts "═" * 70
  puts "Running #{runs} rounds, each in a different random order.".colorize(:yellow)
  puts "Goal: verify that jury scores are stable across independent runs.\n\n"

  # results[cand_name] = { naive: [], jury: [] }
  results = ex[:candidates].each_with_object({}) do |(_key, cand), h|
    h[cand[:name]] = { naive: [], jury: [] }
  end

  runs.times do |round_idx|
    shuffled = ex[:candidates].to_a.shuffle
    puts "─" * 70
    puts " Round #{round_idx + 1}/#{runs} (random order)".colorize(:cyan).bold
    puts "─" * 70

    shuffled.each do |_cand_key, cand|
      print "  [R#{round_idx + 1}] #{cand[:name].ljust(20)}... ".colorize(:light_white)

      score_naive = with_retry { BiasLab::BiasEvaluator.run_naive_evaluation(cand[:resume], ex[:criteria]) }

      res_jury   = with_retry { BiasLab::BiasEvaluator.run_council_evaluation(cand[:resume], ex[:criteria], ex[:juries]) }
      score_jury = res_jury.data.to_i

      results[cand[:name]][:naive] << score_naive
      results[cand[:name]][:jury]  << score_jury

      puts "Naive: #{score_naive.to_s.rjust(3).colorize(:light_red)} | Jury: #{score_jury.to_s.rjust(3).colorize(:light_green)}"
    end
    puts
  end

  # Compute stats per candidate for both approaches
  stats = results.sort_by { |_name, r| -(r[:jury].sum.to_f / r[:jury].size) }.map do |name, r|
    naive_scores = r[:naive]
    jury_scores  = r[:jury]

    naive_range  = naive_scores.max - naive_scores.min
    naive_mean   = naive_scores.sum.to_f / naive_scores.size
    naive_stddev = Math.sqrt(naive_scores.sum { |s| (s - naive_mean)**2 } / naive_scores.size).round(1)

    jury_range   = jury_scores.max - jury_scores.min
    jury_mean    = jury_scores.sum.to_f / jury_scores.size
    jury_stddev  = Math.sqrt(jury_scores.sum { |s| (s - jury_mean)**2 } / jury_scores.size).round(1)

    {
      name:         name,
      naive_scores: naive_scores,
      jury_scores:  jury_scores,
      naive_range:  naive_range,
      naive_stddev: naive_stddev,
      jury_range:   jury_range,
      jury_stddev:  jury_stddev
    }
  end

  # ─── Unified side-by-side report ───────────────────────────────────────────
  run_headers = (1..runs).map { |r| "Run #{r}".rjust(6) }.join(" | ")
  
  # Width calculation:
  # Candidate (20) + 3 (" | ") + 3 runs (3 * 6 + 2 * 3 = 24) + 3 (" | ") + Range (6) + 3 (" | ") + StdDev (6) = 65 chars for one side
  # Plus " || " (4) = 134 chars total width
  table_width = 134
  puts "═" * table_width
  puts " 📊  CONSISTENCY REPORT — #{runs} RUNS  ".center(table_width, "═").colorize(:cyan).swap
  puts "═" * table_width

  # Print section headers centered over the column groups
  puts " " * 22 + " [ NAIVE SCORES ] ".center(44).colorize(:light_red) + " || " + " [ JURY SCORES ] ".center(44).colorize(:light_green)
  
  # Print column subheaders
  puts "  #{"Candidate".ljust(20)} | #{run_headers} | #{"Range".rjust(6)} | #{"StdDev".rjust(7)} || #{run_headers} | #{"Range".rjust(6)} | #{"StdDev".rjust(7)}"
  puts "  " + "─" * (table_width - 4)

  stats.each do |s|
    naive_cells = s[:naive_scores].map { |v| v.to_s.rjust(6) }.join(" | ")
    jury_cells  = s[:jury_scores].map  { |v| v.to_s.rjust(6) }.join(" | ")

    puts "  #{s[:name].ljust(20)} | " \
         "#{naive_cells} | #{s[:naive_range].to_s.rjust(6)} | #{s[:naive_stddev].to_s.rjust(7)} || " \
         "#{jury_cells} | #{s[:jury_range].to_s.rjust(6)} | #{s[:jury_stddev].to_s.rjust(7)}"
  end

  # Averages row
  avg_naive_range  = (stats.sum { |s| s[:naive_range] }.to_f  / stats.size).round(1)
  avg_naive_stddev = (stats.sum { |s| s[:naive_stddev] }.to_f / stats.size).round(1)
  avg_jury_range   = (stats.sum { |s| s[:jury_range] }.to_f   / stats.size).round(1)
  avg_jury_stddev  = (stats.sum { |s| s[:jury_stddev] }.to_f  / stats.size).round(1)

  blank_run_cells = Array.new(runs, " " * 6).join(" | ")

  puts "  " + "─" * (table_width - 4)
  puts "  #{"AVG ACROSS ALL".ljust(20)} | " \
       "#{blank_run_cells} | #{avg_naive_range.to_s.rjust(6)} | #{avg_naive_stddev.to_s.rjust(7)} || " \
       "#{blank_run_cells} | #{avg_jury_range.to_s.rjust(6)} | #{avg_jury_stddev.to_s.rjust(7)}"

  puts "═" * table_width + "\n\n"
end

