# Retry wrapper for LLM calls that may transiently fail.
# Raises the last error if all attempts are exhausted.
#
# @param attempts [Integer] Max number of tries.
# @param delay [Numeric] Seconds to sleep between retries.
# @yield Block that performs the LLM call and returns its value.
DEFAULT_RETRY_ATTEMPTS = 3
DEFAULT_RETRY_DELAY    = 2

def with_retry(attempts: DEFAULT_RETRY_ATTEMPTS, delay: DEFAULT_RETRY_DELAY)
  tries = 0
  begin
    tries += 1
    yield
  rescue => e
    if tries < attempts
      print " [retry #{tries}/#{attempts - 1}]...".colorize(:yellow)
      sleep delay
      retry
    end
    raise
  end
end

# Main runner logic for executing a specific named example test suite.
#
# @param key [Symbol] Key of the example in EXAMPLES hash.
def run_example(key)
  ex = EXAMPLES[key]
  unless ex
    puts "Error: Example '#{key}' not found.".colorize(:red)
    return
  end

  puts "\n" + "═" * 60
  puts " 🏛️  RUNNING: #{ex[:name].upcase}  🏛️ ".colorize(:cyan).swap
  puts "═" * 60 + "\n\n"

  leaderboard = []

  puts "Evaluating #{ex[:candidates].size} Candidates against Job Criteria...".colorize(:yellow)
  puts "═" * 60

  ex[:candidates].each do |_cand_key, cand|
    print "Evaluating #{cand[:name]}... ".colorize(:light_white)
    
    # 1. Naive Scoring
    score_naive = with_retry { BiasLab::BiasEvaluator.run_naive_evaluation(cand[:resume], ex[:criteria]) }

    # 2. Jury Scoring
    res_jury   = with_retry { BiasLab::BiasEvaluator.run_council_evaluation(cand[:resume], ex[:criteria], ex[:juries]) }
    score_jury = res_jury.data.to_i

    leaderboard << {
      name: cand[:name],
      naive: score_naive,
      jury: score_jury
    }

    puts "Done. Naive: #{score_naive.to_s.colorize(:light_red)} | Jury: #{score_jury.to_s.colorize(:light_green)}"
