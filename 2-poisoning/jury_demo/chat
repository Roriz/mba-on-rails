#!/usr/bin/env ruby
# frozen_string_literal: true

# Custom String extensions for terminal colors without external dependencies
class String
  COLORS = {
    red: 31, green: 32, yellow: 33, blue: 34, magenta: 35, cyan: 36,
    light_black: 90, light_red: 91, light_green: 92, light_yellow: 93,
    light_blue: 94, light_magenta: 95, light_cyan: 96, white: 97
  }.freeze

  def colorize(color)
    code = COLORS[color] || 37
    "\e[#{code}m#{self}\e[0m"
  end

  def swap
    "\e[7m#{self}\e[0m"
  end

  def bold
    "\e[1m#{self}\e[0m"
  end
end

def load_env(file_path)
  return unless File.exist?(file_path)

  File.readlines(file_path).each do |line|
    next if line.strip.empty? || line.strip.start_with?('#')

    key, val = line.strip.split('=', 2)
    ENV[key.strip] = val.strip.sub(/\A['"]/, '').sub(/['"]\z/, '') if key
  end
end

# Load .env file looking up the tree
[
  File.expand_path('../.env', __dir__),
  File.expand_path('../../.env', __dir__),
  File.expand_path('../../../.env', __dir__)
].uniq.each { |path| load_env(path) }

require_relative 'lib/bias_evaluator'

# Ensure API key is set
if ENV['GEMINI_API_KEY'].nil? || ENV['GEMINI_API_KEY'].empty?
  puts "\n[!] ERROR: GEMINI_API_KEY is not set.".colorize(:red)
  puts 'Please create a '.colorize(:yellow) + '.env'.colorize(:light_blue) + ' file in the root of the project with:'.colorize(:yellow)
  puts "GEMINI_API_KEY=your_api_key_here\n\n".colorize(:light_cyan)
  exit 1
end

# Configure the Bias Mitigation Environment
BiasLab::BiasEvaluator.setup_configuration!

puts "\n" + "═" * 60
puts " 🏛️  ACTIVEGENIE JURYBENCH - COUNCILS VS NAIVE BIAS LAB  🏛️ ".colorize(:cyan).swap
puts "═" * 60
puts "This lab demonstrates Segment 5: The Bias Performance Tax &".colorize(:light_black)
puts "how the Council of Judges pattern mitigates proxy variable bias.".colorize(:light_black)
puts "═" * 60 + "\n\n"

puts "We have two candidates with ".colorize(:white) + "IDENTICAL".colorize(:green).bold + " technical experience:"
puts "  * " + "Candidate A: Adam Smith".colorize(:light_cyan) + " (Harvard University, Upper East Side NY)"
puts "  * " + "Candidate B: Mohamed Al-Farsi".colorize(:light_cyan) + " (Cairo University, Queens NY)"
puts "-" * 60

# --- NAIVE RUN ---
puts "\n▶ Running " + "Phase 1: Naive Single-Model Evaluation".colorize(:light_red).bold
puts "Evaluating both candidates using a single naive scoring model..."
print "Thinking...".colorize(:light_black)

begin
  score_adam_naive = BiasLab::BiasEvaluator.run_naive_evaluation(BiasLab::BiasEvaluator::RESUME_ADAM)
  score_mohamed_naive = BiasLab::BiasEvaluator.run_naive_evaluation(BiasLab::BiasEvaluator::RESUME_MOHAMED)
  
  # Clear the thinking message
  print "\r#{' ' * 30}\r"
  
  puts "\n" + " Naive Model Scoreboard ".center(40, "─").colorize(:light_red)
  puts "  * Adam Smith Score     : " + "#{score_adam_naive} / 100".colorize(:light_green).bold
  puts "  * Mohamed Al-Farsi Score: " + "#{score_mohamed_naive} / 100".colorize(:light_red).bold
