  res_adam = BiasLab::BiasEvaluator.run_council_evaluation(BiasLab::BiasEvaluator::RESUME_ADAM)
  res_mohamed = BiasLab::BiasEvaluator.run_council_evaluation(BiasLab::BiasEvaluator::RESUME_MOHAMED)
  print "\r#{' ' * 30}\r"

  juries_metadata = [
    { name: 'Recruiting Specialist', key: 'recruiting_specialist' },
    { name: 'Hard Technical Auditor', key: 'hard_technical_auditor' },
    { name: 'Diversity Compliance Officer', key: 'diversity_compliance_officer' }
  ]

  # Display Adam's Council Breakdown
  puts " Candidate A: Adam Smith - Council Card ".center(60, "═").colorize(:cyan)
  juries_metadata.each do |j|
    score = res_adam.metadata["#{j[:key]}_score"]
    reasoning = res_adam.metadata["#{j[:key]}_reasoning"]
    puts "  ▶ #{j[:name].colorize(:light_yellow).bold} (Score: #{score.to_i}/100)"
    puts "    \"#{reasoning}\"".colorize(:white)
    puts "  " + "─" * 56
  end
  puts "  Consensus Score: " + "#{res_adam.data.to_i} / 100".colorize(:light_green).bold
  puts "═" * 60 + "\n\n"

  # Display Mohamed's Council Breakdown
  puts " Candidate B: Mohamed Al-Farsi - Council Card ".center(60, "═").colorize(:cyan)
  juries_metadata.each do |j|
    score = res_mohamed.metadata["#{j[:key]}_score"]
    reasoning = res_mohamed.metadata["#{j[:key]}_reasoning"]
    puts "  ▶ #{j[:name].colorize(:light_yellow).bold} (Score: #{score.to_i}/100)"
    puts "    \"#{reasoning}\"".colorize(:white)
    puts "  " + "─" * 56
  end
  puts "  Consensus Score: " + "#{res_mohamed.data.to_i} / 100".colorize(:light_green).bold
  puts "═" * 60 + "\n\n"

  # Comparison & Reduction
  puts " Final ActiveGenie Bias Reduction Analysis ".center(60, "═").colorize(:green).swap
  puts "  * Adam Smith Consensus     : " + "#{res_adam.data.to_i} / 100".colorize(:light_green).bold
  puts "  * Mohamed Al-Farsi Consensus: " + "#{res_mohamed.data.to_i} / 100".colorize(:light_green).bold
  final_gap = (res_adam.data.to_i - res_mohamed.data.to_i).abs
  puts "  * Council Bias Gap Variance: " + "#{final_gap} points".colorize(:green).bold
  puts "═" * 60
  puts "[Conclusion] The JuryBench consensus successfully aligned the scores to objective parity!".colorize(:white)
  puts " By introducing multi-persona checks (Compliance & Audit), the system Cigar-cuts proxy biases.".colorize(:light_green)
  puts "\n"
rescue StandardError => e
  print "\r#{' ' * 30}\r"
  puts "JuryBench Error: #{e.message}".colorize(:red)
end
