#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/interactive_chat_runner'
require_relative 'hello_assistant'

InteractiveChatRunner.setup_environment!

runner = InteractiveChatRunner.new(
  title: ' 🚗 HELLO WORLD ASSISTANT (INITIALIZATION) 🚗 ',
  intro: 'Hello! I am your simple Hello World assistant. How can I help you today?',
  color: :light_green,
  assistant_class: Chatbots::HelloAssistant
)
runner.run!
